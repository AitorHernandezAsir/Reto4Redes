ssh-keygen -t rsa -b 4096 -f ~/.ssh/clave_gari -N ""
ssh-keygen -t rsa -b 4096 -f ~/.ssh/clave_antonio -N ""
ssh-keygen -t rsa -b 4096 -f ~/.ssh/clave_serrato -N ""
ssh-keygen -t rsa -b 4096 -f ~/.ssh/clave_endika -N ""
